<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="600mm"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="38mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27mm"
                android:layout_height="27mm"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:text="@string/sender_output_title"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="60mm"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="25mm"
            android:text="@string/sender_processing" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="20mm"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="25mm" />

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="125mm"
            android:layout_marginRight="42mm"
            android:layout_marginBottom="45mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/close_go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21mm"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>