<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Aging"
            android:textColor="@color/white"
            android:textSize="37mm" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:orientation="vertical">


                <fragment
                    android:id="@+id/cpuframe"
                    android:name="com.glorystar.startool.ui.fragment.CPUKtTestFragment"
                    android:layout_width="match_parent"
                    android:layout_height="415mm" />

                <fragment
                    android:id="@+id/emmcFrame"
                    android:name="com.glorystar.startool.ui.fragment.MemoryTestKtFragment"
                    android:layout_width="match_parent"
                    android:layout_height="415mm"
                    android:layout_marginTop="20mm" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:orientation="vertical">


                <fragment
                    android:id="@+id/ddrFrame"
                    android:name="com.glorystar.startool.ui.fragment.DDRTestKtFragment"
                    android:layout_width="match_parent"
                    android:layout_height="451mm"
                    android:layout_marginTop="20mm" />

                <fragment
                    android:id="@+id/videoFrame"
                    android:name="com.glorystar.startool.ui.fragment.VideoTestKtFragment"
                    android:layout_width="match_parent"
                    android:layout_height="451mm"
                    android:layout_marginTop="20mm" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>
</LinearLayout>