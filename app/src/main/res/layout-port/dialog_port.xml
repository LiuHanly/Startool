<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="600mm"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="38mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27mm"
                android:layout_height="27mm"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:text="@string/uart_port"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="60mm"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="37mm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="125mm"
            android:layout_marginRight="42mm"
            android:layout_marginBottom="45mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/close_go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21mm"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relative_help"
        android:layout_width="match_parent"
        android:layout_height="77mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30mm"
        android:background="@drawable/selector_mode_bg"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_help"
            android:layout_width="29mm"
            android:layout_height="29mm"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30mm"
            android:src="@drawable/ic_help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24mm"
            android:layout_toRightOf="@+id/iv_help"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/uart_tip"
            android:textColor="@color/white"
            android:textSize="23mm" />
    </LinearLayout>
</RelativeLayout>