<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.VegaActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20mm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/relative_relay"
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="12mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_1"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_gpio"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_1"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/relay"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <ImageView
                    android:layout_width="51mm"
                    android:layout_height="51mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow"/>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_wiegand"
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_2"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_chips"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_2"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/wiegand_interface"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <ImageView
                    android:layout_width="51mm"
                    android:layout_height="51mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_3"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_chips"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_3"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/rs485"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_485"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:background="@drawable/r_button_bg"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:textSize="21mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:text="@string/open_port"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_4"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_gpio"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_4"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/input_prot_3"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_input"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/test"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_5"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_camera"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_5"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/camera"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_camera"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/test"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_6"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_sensor"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv_6"
                    android:layout_marginLeft="24mm"
                    android:layout_centerVertical="true"
                    android:textColor="@color/white"
                    android:textSize="25mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/sensors"/>

                <Button
                    android:id="@+id/bt_sensor"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/test"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_7"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_rfid"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_7"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/rfid"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_rfid"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/test"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_8"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_led"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_8"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/led"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_led"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/turn_on"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_15"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_light_strip"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/iv_15"
                    android:layout_marginLeft="24mm"
                    android:layout_centerVertical="true"
                    android:textColor="@color/white"
                    android:textSize="25mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/light_strips"/>

                <Button
                    android:id="@+id/bt_light"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/test"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="103mm"
                android:layout_marginLeft="30mm"
                android:layout_marginRight="30mm"
                android:layout_marginTop="20mm"
                android:paddingLeft="24mm"
                android:paddingRight="24mm"
                android:background="@drawable/selector_mode_bg">
                <ImageView
                    android:id="@+id/iv_16"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:src="@drawable/ic_loop"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24mm"
                    android:layout_toRightOf="@+id/iv_16"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/loop_out"
                    android:textColor="@color/white"
                    android:textSize="25mm" />

                <Button
                    android:id="@+id/bt_play"
                    android:layout_width="150mm"
                    android:layout_height="55mm"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="24mm"
                    android:layout_toLeftOf="@+id/bt_loop"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/play"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />

                <Button
                    android:id="@+id/bt_loop"
                    android:layout_width="150mm"
                    android:layout_height="55mm"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/turn_on"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21mm" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>