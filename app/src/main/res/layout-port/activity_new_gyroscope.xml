<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/sensor_name_test"
            android:textColor="@color/white"
            android:textSize="37mm" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/proximity_output"
                    android:textColor="@color/colorFont"
                    android:textSize="23mm" />

                <TextView
                    android:id="@+id/tv_proximity_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/white"
                    android:textSize="37mm"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/ambient_output"
                    android:textColor="@color/colorFont"
                    android:textSize="23mm" />

                <TextView
                    android:id="@+id/tv_ambient_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/white"
                    android:textSize="37mm"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="435mm"
            android:background="@drawable/selector_mode_bg">

            <ImageView
                android:id="@+id/image1"
                android:layout_width="118mm"
                android:layout_height="294mm"
                android:layout_centerVertical="true"
                android:layout_marginLeft="60mm"
                android:src="@mipmap/arrow_left" />

            <ImageView
                android:layout_width="294mm"
                android:layout_height="294mm"
                android:layout_centerInParent="true"
                android:src="@mipmap/device" />

            <ImageView
                android:id="@+id/image2"
                android:layout_width="118mm"
                android:layout_height="294mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="60mm"
                android:src="@mipmap/arrow_right" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48mm"
            tools:ignore="MissingConstraints">


            <Button
                android:id="@+id/through_bu"
                android:layout_width="121mm"
                android:layout_height="55mm"
                android:layout_alignParentEnd="true"
                android:layout_marginRight="100mm"
                android:background="@drawable/r_button_bg"
                android:text="@string/NEXTBUTTON"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm"
                tools:ignore="InOrmmUsage" />


        </RelativeLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>