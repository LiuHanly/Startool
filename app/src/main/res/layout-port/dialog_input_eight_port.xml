<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_weight="1"
            android:layout_marginTop="38mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27mm"
                android:layout_height="27mm"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:text="@string/input_prot"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="20mm"
            android:layout_marginRight="20mm"
            android:layout_marginTop="56mm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0mm"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_1"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_1"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_2"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_2"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_3"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_3"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_4"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_4"/>

                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0mm"
                android:orientation="horizontal"
                android:layout_marginTop="10mm"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_5"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_5"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_6"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_6"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_7"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_7"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/iv_input_8"
                            android:layout_width="140mm"
                            android:layout_height="140mm"
                            android:src="@drawable/input_port_original"/>


                        <TextView
                            android:id="@+id/tv_input_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_regular"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm"
                            android:text="@string/ready"/>

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26mm"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="25mm"
                        android:text="@string/port_8"/>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="60mm"
            android:layout_marginRight="42mm"
            android:layout_marginBottom="35mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21mm"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relative_help"
        android:layout_width="match_parent"
        android:layout_height="77mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginBottom="30mm"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:background="@drawable/selector_mode_bg">

        <ImageView
            android:id="@+id/iv_help"
            android:layout_width="29mm"
            android:layout_height="29mm"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30mm"
            android:src="@drawable/ic_help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24mm"
            android:fontFamily="@font/montserrat_regular"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/iv_help"
            android:textSize="23mm"
            android:text="@string/input_port_tip"
            android:textColor="@color/white"/>
    </LinearLayout>
</RelativeLayout>