<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/hdmi_speaker_name_test"
            android:textColor="@color/white"
            android:textSize="37mm" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        tools:ignore="MissingConstraints">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/left_volime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@id/RecyclerLayout"
                android:rotation="180"
                android:src="@drawable/icon_volume" />

            <VideoView
                android:id="@+id/RecyclerLayout"
                android:layout_width="400mm"
                android:layout_height="400mm"
                android:layout_centerInParent="true" />

            <ImageView
                android:id="@+id/right_volime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/RecyclerLayout"
                android:src="@drawable/icon_volume" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48mm"
            android:paddingRight="100mm"
            tools:ignore="MissingConstraints">


            <Button
                android:id="@+id/through_bu"
                android:layout_width="121mm"
                android:layout_height="55mm"
                android:layout_alignParentEnd="true"
                android:background="@drawable/r_button_bg"
                android:text="@string/NEXTBUTTON"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm"
                tools:ignore="InOrmmUsage" />


        </RelativeLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>