<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView

        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_margin="15mm"
        android:textColor="@color/white"
        android:textSize="18mm" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="45mm"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image_name"
            android:layout_width="40mm"
            android:layout_height="40mm" />
        <TextView
            android:textSize="23mm"
            android:layout_marginLeft="10mm"
            android:layout_gravity="center"
            android:id="@+id/masg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="0.5mm"
        android:layout_below="@id/name_text"
        android:layout_marginLeft="15mm"

        android:layout_marginRight="50mm"

        android:background="@color/white" />
</RelativeLayout>