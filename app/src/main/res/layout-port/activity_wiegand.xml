<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.WiegandActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:orientation="vertical"
            android:background="@drawable/selector_mode_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24mm"
                android:layout_marginTop="36mm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_info"
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:src="@drawable/ic_chips"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/white"
                    android:textSize="25mm"
                    android:text="@string/kit_input_title"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24mm"
                android:layout_marginTop="36mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:text="@string/kit_input_detail"
                android:textSize="25mm"/>


            <Button
                android:id="@+id/bt_start_test"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:layout_marginTop="40mm"
                android:layout_marginRight="24mm"
                android:layout_marginBottom="20mm"
                android:layout_gravity="right|bottom"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="21mm"
                android:textAllCaps="false"
                android:text="@string/start_test"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:orientation="vertical"
            android:background="@drawable/selector_mode_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24mm"
                android:layout_marginTop="36mm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="31mm"
                    android:layout_height="31mm"
                    android:src="@drawable/ic_chips"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24mm"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/white"
                    android:textSize="25mm"
                    android:text="@string/wiegand_input_title"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24mm"
                android:layout_marginTop="36mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:text="@string/wiegand_input_detail"
                android:textSize="25mm"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="bottom|right"
                android:layout_marginTop="40mm"
                android:layout_marginRight="24mm"
                android:layout_marginBottom="20mm">

                <Button
                    android:id="@+id/bt_sender"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_marginRight="24mm"
                    android:layout_gravity="right|bottom"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="21mm"
                    android:textAllCaps="false"
                    android:text="@string/sender"/>

                <Button
                    android:id="@+id/bt_receiver"
                    android:layout_width="191mm"
                    android:layout_height="55mm"
                    android:layout_gravity="right|bottom"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textSize="21mm"
                    android:text="@string/receiver"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>