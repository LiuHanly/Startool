<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="103mm"
    android:layout_marginTop="24mm"
    android:background="@drawable/selector_mode_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="24mm"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="31mm"
            android:layout_height="31mm" />

        <TextView
            android:id="@+id/tv_title_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24mm"
            android:textColor="@color/white"
            android:textSize="25mm"
            tools:ignore="InvalidId" />
    </LinearLayout>

    <CheckBox

        android:id="@+id/checkBox"
        android:layout_width="45mm"
        android:layout_height="45mm"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="29mm"
        android:background="@drawable/check_style"
        android:button="@null" />

</RelativeLayout>