<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    tools:context=".ui.activity.SM6255Activity">


    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        tools:ignore="MissingConstraints" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <RelativeLayout
            android:id="@+id/relative_sensor"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="14mm"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24mm"
            android:paddingRight="24mm">

            <ImageView
                android:id="@+id/iv_4"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_sensor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24mm"
                android:layout_toRightOf="@+id/iv_4"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/sensors"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <Button
                android:id="@+id/bt_sensor"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_buttons"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="14mm"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24mm"
            android:paddingRight="24mm">

            <ImageView
                android:id="@+id/iv_5"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_buttons" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24mm"
                android:layout_toRightOf="@+id/iv_5"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/buttons"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <Button
                android:id="@+id/bt_buttons"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="14mm"
            android:layout_marginBottom="14mm"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24mm"
            android:paddingRight="24mm">

            <ImageView
                android:id="@+id/iv_15"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_light_strip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24mm"
                android:layout_toRightOf="@+id/iv_15"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/light_strips"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <Button
                android:id="@+id/bt_light"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm" />
        </RelativeLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>