<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical"
    tools:context=".ui.activity.TestReportActivity">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="116mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Preaging_report"
            android:textColor="@color/white"
            android:textSize="37mm" />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="48mm"
            android:paddingRight="48mm">

            <LinearLayout
                android:id="@+id/recyclerView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_mode_bg"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/DATE"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/TIME"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/Serial_number"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/Model"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/Android_version"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/Build_number"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="50mm"
                            android:text="DDR ："
                            android:textColor="@color/white"
                            android:textSize="25mm"
                            tools:layout_editor_absoluteX="14mm"
                            tools:layout_editor_absoluteY="59mm" />

                        <TextView
                            android:id="@+id/Inter_shared_storage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/MAC"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5mm"
                        android:layout_marginLeft="25mm"
                        android:layout_marginTop="15mm"
                        android:layout_marginRight="50mm"
                        android:layout_marginBottom="15mm"
                        android:background="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="25mm"
                        android:layout_marginBottom="25mm">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginRight="50mm"
                            android:text="@string/Menory"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <TextView
                            android:id="@+id/Serial_number5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="50mm"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </RelativeLayout>


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="691mm"
                    android:layout_marginTop="24mm"
                    android:background="@drawable/selector_mode_bg"
                    android:padding="15mm"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <Button
                    android:id="@+id/finish_buton"
                    android:layout_width="223mm"
                    android:layout_height="55mm"
                    android:layout_gravity="right"
                    android:layout_marginStart="32mm"
                    android:layout_marginTop="60mm"
                    android:background="@drawable/r_button_bg"
                    android:text="@string/Finish_leave"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="25mm" />
            </LinearLayout>
        </ScrollView>

    </RelativeLayout>
</LinearLayout>