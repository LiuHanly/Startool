<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.Neb101Activity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <RelativeLayout
            android:id="@+id/relative_gpio"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:layout_marginTop="14mm"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24mm"
                android:layout_toRightOf="@+id/iv_1"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/gpio"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <ImageView
                android:layout_width="51mm"
                android:layout_height="51mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_wiegand"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:layout_marginTop="20mm"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_2"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24mm"
                android:layout_toRightOf="@+id/iv_2"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/wiegand_interface"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <ImageView
                android:layout_width="51mm"
                android:layout_height="51mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_uart"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:layout_marginTop="20mm"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_3"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_3"
                android:layout_marginLeft="24mm"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/uart"/>

            <Button
                android:id="@+id/bt_uart"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:background="@drawable/r_button_bg"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textSize="21mm"
                android:fontFamily="@font/montserrat_regular"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:text="@string/open_port"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_sensor"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:layout_marginTop="20mm"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_4"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_sensor"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_4"
                android:layout_marginLeft="24mm"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/sensors"/>

            <Button
                android:id="@+id/bt_sensor"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_buttons"
            android:layout_width="match_parent"
            android:layout_height="103mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:layout_marginTop="20mm"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_5"
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_buttons"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_5"
                android:layout_marginLeft="24mm"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/buttons"/>

            <Button
                android:id="@+id/bt_buttons"
                android:layout_width="191mm"
                android:layout_height="55mm"
                android:background="@drawable/r_button_bg"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textSize="21mm"
                android:fontFamily="@font/montserrat_regular"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:text="@string/test"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>