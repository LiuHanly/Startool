<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginBottom="30mm"
            android:text="@string/gyroscope_name_test"
            android:textColor="@color/white"
            android:textSize="37mm" />

    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/gyroscope_instruction"
        android:textColor="@color/white"
        android:layout_marginBottom="30mm"
        android:textSize="25mm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="610mm"
            android:layout_marginLeft="30mm"
            android:layout_marginRight="30mm"
            android:background="@drawable/selector_mode_bg">

            <ImageView
                android:id="@+id/image1"
                android:layout_width="294mm"
                android:layout_height="294mm"
                android:layout_centerVertical="true"
                android:src="@mipmap/arrow_left" />

            <ImageView
                android:layout_width="294mm"
                android:layout_height="294mm"
                android:layout_centerInParent="true"
                android:src="@mipmap/device" />

            <ImageView
                android:id="@+id/image2"
                android:layout_width="294mm"
                android:layout_height="294mm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/arrow_right" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60mm"

            android:layout_marginBottom="30mm"
            android:textColor="@color/white"
            android:textSize="25mm" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48mm"
            tools:ignore="MissingConstraints">


            <Button
                android:layout_marginLeft="123mm"
                android:id="@+id/failure_bu"
                android:layout_width="121mm"
                android:layout_height="55mm"
                android:background="@drawable/r_button_bg"
                android:text="@string/Failed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm"
                tools:ignore="InOrMmUsage" />


            <Button
                android:layout_marginRight="123mm"
                android:id="@+id/through_bu"
                android:layout_width="121mm"
                android:layout_height="55mm"
                android:layout_alignParentEnd="true"
                android:background="@drawable/r_button_bg"
                android:text="@string/Passed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21mm"
                tools:ignore="InOrMmUsage" />


        </RelativeLayout>
    </LinearLayout>


</LinearLayout>