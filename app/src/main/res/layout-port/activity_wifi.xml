<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical"
    tools:context=".ui.activity.WifiActivity">
    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="116mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/wifi_test"
            android:textColor="@color/white"
            android:textSize="37mm" />


    </RelativeLayout>
  <TextView
      android:gravity="center"
      android:text="@string/wifi_status"
      android:textColor="@color/white"
      android:textSize="25mm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        app:layout_constraintVertical_bias="0.524">

        <RelativeLayout style="@style/device_relative_port">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="50mm"
                android:text="@string/Ap"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/ap_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>


        <RelativeLayout style="@style/device_relative_port">

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="50mm"
                android:text="@string/Status"
                android:textColor="@color/white"
                android:textSize="25mm" />


            <TextView
                android:id="@+id/text_Model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />
        </RelativeLayout>


        <LinearLayout
            style="@style/device_relative_port"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40mm"
                android:layout_height="40mm"
                android:src="@mipmap/wifixxxhdpi" />

            <com.glorystar.startool.ui.view.ColorGradientProgressBar
                android:id="@+id/colorgradgressbar"
                android:layout_width="wrap_content"
                android:layout_height="40mm"
                android:layout_marginLeft="25mm"
                android:layout_marginRight="50mm"
                android:layout_weight="1"
                tools:ignore="MissingClass" />

            <TextView
                android:id="@+id/Android_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:text="dBm"
                android:textColor="@color/white"
                android:textSize="25mm" />
        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="123mm"
        android:layout_marginTop="50mm"
        android:layout_marginRight="123mm"

        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <Button
            android:id="@+id/failure_bu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/Failed"
            android:textColor="@color/white"
            android:textSize="15mm" />

        <TextView
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Restart"
            android:textColor="@color/colorMainButton"
            android:textSize="15mm"
            tools:ignore="InOrMmUsage" />


        <Button
            android:id="@+id/through_bu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/Passed"
            android:textColor="@color/white"
            android:textSize="15mm" />
    </RelativeLayout>


</LinearLayout>