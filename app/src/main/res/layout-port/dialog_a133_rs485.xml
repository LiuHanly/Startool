<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="600mm"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="38mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27mm"
                android:layout_height="27mm"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12mm"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25mm"
                android:text="@string/uart_port"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30mm"
            android:layout_marginTop="60mm"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="37mm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="125mm"
            android:layout_marginRight="42mm"
            android:layout_marginBottom="45mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/close_go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21mm"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relative_help"
        android:layout_width="match_parent"
        android:layout_height="77mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30mm"
        android:background="@drawable/selector_mode_bg"
        android:gravity="center">

        <EditText
            android:id="@+id/edit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20mm"
            android:layout_weight="1"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="20mm"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/bt_send"
            android:layout_width="140mm"
            android:layout_height="55mm"
            android:layout_marginLeft="36mm"
            android:layout_marginTop="18mm"
            android:layout_marginBottom="18mm"
            android:layout_marginRight="20mm"
            android:background="@drawable/r_button_bg"
            android:fontFamily="@font/montserrat_regular"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="21mm"
            android:gravity="center"
            android:textAllCaps="false"
            android:text="@string/send_now"/>
    </LinearLayout>
</RelativeLayout>