<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="116mm"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tile_view"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/preaging_masg_one"
            android:textColor="@color/white"
            android:textSize="25mm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/preaging_masg_tow"
            android:textColor="@color/white"
            android:textSize="25mm" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ageing_fro_recy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/Relative"
        android:layout_below="@+id/linearLayout"
        android:paddingLeft="60mm"
        android:paddingRight="60mm" />

    <RelativeLayout
        android:layout_marginTop="43mm"
        android:id="@+id/Relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
         android:layout_marginBottom="48mm"
        >

        <TextView
            android:id="@+id/all_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="100mm"
            android:text="@string/Select_all"
            android:textColor="@color/colorMainButton"
            android:textSize="25mm" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="200mm"
            android:layout_height="79mm"
            android:layout_marginRight="24mm"
            android:layout_alignParentRight="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/Start_test"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="25mm"
            tools:ignore="InOrMmUsage" />


    </RelativeLayout>

</RelativeLayout>