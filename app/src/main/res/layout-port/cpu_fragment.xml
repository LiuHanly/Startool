<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/mtrl_pickeselection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/ext_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="35mm"
                android:layout_marginTop="25mm"
                android:fontFamily="@font/montserrat_semibold"
                android:text="@string/CPU"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="25mm"
                android:layout_marginRight="55mm"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/colorMainButton"
                android:textSize="25mm" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="260mm"
                    android:layout_height="260mm"
                    android:layout_marginRight="60mm">

                    <com.github.lzyzsd.circleprogress.DonutProgress
                        android:id="@+id/pgr_percent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:donut_finished_color="@color/colorMainButton"
                        app:donut_finished_stroke_width="4mm"
                        app:donut_progress="30"
                        app:donut_show_text="false"
                        app:donut_unfinished_color="@color/colorAccentLight"
                        app:donut_unfinished_stroke_width="4mm" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"

                                android:text="@string/CPU_usage"
                                android:textColor="@color/white"
                                android:textSize="27mm" />


                            <LinearLayout
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20mm"
                                android:orientation="horizontal">

                                <com.glorystar.startool.ui.view.DincondFontTextView
                                    android:id="@+id/tv_percent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:text="30"
                                    android:textColor="@color/white"
                                    android:textSize="37mm"
                                    android:textStyle="bold" />

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_above="@id/tv_percent"
                                    android:layout_centerHorizontal="true"
                                    android:text="@string/cpu_test_cur_freq"
                                    android:textColor="@color/white"
                                    android:textSize="37mm" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignBottom="@id/tv_percent"
                                    android:layout_toRightOf="@id/tv_percent"
                                    android:text="%"
                                    android:textColor="@color/white"
                                    android:textSize="37mm"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </RelativeLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="260mm"
                    android:layout_height="260mm">

                    <com.github.lzyzsd.circleprogress.DonutProgress
                        android:id="@+id/pgr_freq"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:donut_finished_color="@color/colorMainButton"
                        app:donut_finished_stroke_width="4mm"
                        app:donut_progress="30"
                        app:donut_show_text="false"
                        app:donut_unfinished_color="@color/colorAccentLight"
                        app:donut_unfinished_stroke_width="4mm" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:text="@string/Current_freq"
                                android:textColor="@color/white"
                                android:textSize="23mm" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20mm"
                                android:orientation="horizontal">

                                <com.glorystar.startool.ui.view.DincondFontTextView
                                    android:id="@+id/tv_freq"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:text="800"
                                    android:textColor="@color/white"
                                    android:textSize="37mm"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/tv_freq"
                                    android:layout_centerHorizontal="true"
                                    android:text="MHz"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </LinearLayout>

                            <LinearLayout

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="5mm"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_freq_max"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1200"
                                    android:textColor="@color/colorFont"
                                    android:textSize="23mm" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3mm"
                                    android:text="MHz"
                                    android:textColor="@color/colorFont"
                                    android:textSize="23mm" />

                            </LinearLayout>

                        </LinearLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="@string/cpu_test_cur_freq"
                            android:textColor="@color/white"
                            android:textSize="35mm" />


                    </RelativeLayout>
                </FrameLayout>

            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>