<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <FrameLayout
        android:id="@+id/FrameLayoutDragImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48mm"
        android:text="@string/touch_view_masg_one"
        android:textColor="@color/black"
        android:textSize="50mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30mm"
        android:paddingLeft="100mm"
        android:paddingRight="100mm"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:paddingLeft="10mm"
            android:paddingRight="10mm"
            android:id="@+id/through_buse"
            android:layout_width="wrap_content"
            android:layout_height="55mm"
            android:background="@drawable/r_button_bg"
            android:text="@string/step"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21mm"
            tools:ignore="InOrmmUsage" />

        <Button
            android:id="@+id/through_bu"
            android:layout_width="121mm"
            android:layout_height="55mm"
            android:layout_alignParentEnd="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/NEXTBUTTON"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21mm"
            tools:ignore="InOrmmUsage" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>