<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical"
    tools:context=".ui.activity.TestReportActivity">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Preaging_report"
            android:textColor="@color/white"
            android:textSize="37mm" />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24mm"
                    android:orientation="vertical"
                 >

                    <LinearLayout

                        android:id="@+id/recyclerView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="4mm"
                        android:layout_marginTop="0mm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/selector_mode_bg"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/DATE"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/TIME"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number7"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/Serial_number"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/Model"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/Android_version"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/Build_number"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="50mm"
                                    android:gravity="right"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="50mm"
                                    android:text="DDR ："
                                    android:textColor="@color/white"
                                    android:textSize="25mm"
                                    tools:layout_editor_absoluteX="14mm"
                                    tools:layout_editor_absoluteY="59mm" />

                                <TextView

                                    android:id="@+id/Inter_shared_storage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/MAC"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5mm"
                                android:layout_marginLeft="25mm"
                                android:layout_marginTop="15mm"
                                android:layout_marginRight="50mm"
                                android:layout_marginBottom="15mm"
                                android:background="@color/white" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="25mm"
                                android:layout_marginBottom="25mm">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginRight="50mm"
                                    android:text="@string/Menory"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                                <TextView
                                    android:id="@+id/Serial_number5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="50mm"
                                    android:textColor="@color/white"
                                    android:textSize="25mm" />

                            </RelativeLayout>


                        </LinearLayout>


                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_marginTop="24mm"
                        android:layout_height="691mm"
                        android:background="@drawable/selector_mode_bg"
                        android:padding="15mm"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/finish_buton"
                            android:layout_width="223mm"
                            android:layout_height="55mm"
                            android:layout_marginStart="32mm"
                            android:layout_marginTop="60mm"
                            android:background="@drawable/r_button_bg"
                            android:text="@string/Finish_leave"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <Button
                            android:id="@+id/finish_buton1"
                            android:layout_width="223mm"
                            android:layout_height="55mm"
                            android:layout_marginStart="32mm"
                            android:layout_marginTop="60mm"
                            android:background="@drawable/r_button_bg"
                            android:text="@string/factory_reset"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</LinearLayout>