<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical"
    tools:context=".ui.activity.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="104mm">

        <ImageView
            android:id="@+id/iv_update"
            android:layout_width="36mm"
            android:layout_height="36mm"
            android:layout_centerVertical="true"
            android:layout_marginRight="30mm"
            android:layout_toLeftOf="@+id/textlanguage"
            android:src="@drawable/ic_info" />

        <TextView
            android:id="@+id/textlanguage"
            android:layout_width="44mm"
            android:layout_height="44mm"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="30mm"
            android:gravity="center"
            android:text="@string/language"
            android:textColor="@color/white"
            android:textSize="30mm" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20mm"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/logo_startoo"
                    android:layout_width="584mm"
                    android:layout_height="315mm"
                    android:src="@mipmap/startoolslogo"
                    tools:ignore="InOrMmUsage,NotSibling" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60mm"
                    android:gravity="center"
                    android:text="@string/select"
                    android:textColor="@color/colorFont"
                    android:textSize="23mm"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30mm"
                android:layout_marginTop="30mm"
                android:layout_marginRight="30mm"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="243mm"
                    android:background="@color/colorMainLight"
                    app:cardBackgroundColor="@color/colorMainLight"
                    app:cardCornerRadius="11mm">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24mm"
                        android:layout_marginTop="30mm"
                        android:layout_marginRight="24mm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="31mm"
                                android:layout_height="31mm"
                                android:src="@drawable/ic_general"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/General"
                                android:layout_marginLeft="14mm"
                                android:textColor="@color/white"
                                android:textSize="25mm" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20mm"
                            android:text="@string/General_masg"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_general"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:layout_marginRight="24mm"
                        android:layout_marginBottom="30mm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Enter"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <ImageView
                            android:layout_width="44mm"
                            android:layout_height="44mm"
                            android:src="@drawable/ic_arrow" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="243mm"
                    android:layout_marginTop="20mm"
                    android:background="@color/colorMainLight"
                    app:cardBackgroundColor="@color/colorMainLight"
                    app:cardCornerRadius="11mm">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24mm"
                        android:layout_marginTop="30mm"
                        android:layout_marginRight="24mm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="31mm"
                                android:layout_height="31mm"
                                android:src="@drawable/ic_model"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/Model"
                                android:layout_marginLeft="14mm"
                                android:textColor="@color/white"
                                android:textSize="25mm" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20mm"
                            android:text="@string/Model_masg"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_model"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:layout_marginRight="24mm"
                        android:layout_marginBottom="30mm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Enter"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <ImageView
                            android:layout_width="44mm"
                            android:layout_height="44mm"
                            android:src="@drawable/ic_arrow" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="243mm"
                    android:layout_marginTop="20mm"
                    android:background="@color/colorMainLight"
                    app:cardBackgroundColor="@color/colorMainLight"
                    app:cardCornerRadius="11mm">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24mm"
                        android:layout_marginTop="30mm"
                        android:layout_marginRight="24mm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="31mm"
                                android:layout_height="31mm"
                                android:src="@drawable/ic_addon"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="14mm"
                                android:text="@string/Addon"
                                android:textColor="@color/white"
                                android:textSize="25mm" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20mm"
                            android:text="@string/Addon_masg"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_addon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:layout_marginRight="24mm"
                        android:layout_marginBottom="30mm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Enter"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <ImageView
                            android:layout_width="44mm"
                            android:layout_height="44mm"
                            android:src="@drawable/ic_arrow" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="243mm"
                    android:layout_marginTop="20mm"
                    android:layout_marginBottom="30mm"
                    android:background="@color/colorMainLight"
                    app:cardBackgroundColor="@color/colorMainLight"
                    app:cardCornerRadius="11mm">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24mm"
                        android:layout_marginTop="30mm"
                        android:layout_marginRight="24mm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="31mm"
                                android:layout_height="31mm"
                                android:src="@drawable/ic_aging"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/Aging"
                                android:layout_marginLeft="14mm"
                                android:textColor="@color/white"
                                android:textSize="25mm" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20mm"
                            android:text="@string/Aging_masg"
                            android:textColor="@color/colorFont"
                            android:textSize="23mm" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_aging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:layout_marginRight="24mm"
                        android:layout_marginBottom="30mm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Enter"
                            android:textColor="@color/white"
                            android:textSize="25mm" />

                        <ImageView
                            android:layout_width="44mm"
                            android:layout_height="44mm"
                            android:src="@drawable/ic_arrow" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>