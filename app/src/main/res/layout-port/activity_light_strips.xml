<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.LightStripsActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="77mm"
        android:layout_marginTop="12mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:orientation="horizontal"
        android:background="@drawable/selector_mode_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="24mm"
            android:layout_height="24mm"
            android:src="@drawable/ic_help"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginLeft="27mm"
            android:textColor="@color/white"
            android:textSize="25mm"
            android:text="@string/light_tip"/>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/relative_red"
        android:layout_width="match_parent"
        android:layout_height="103mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginTop="20mm"
        android:paddingLeft="24mm"
        android:paddingRight="24mm"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_1"
            android:layout_width="31mm"
            android:layout_height="31mm"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_light_strip"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/iv_1"
            android:layout_marginLeft="24mm"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="25mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/light_red"/>

        <Button
            android:id="@+id/bt_red"
            android:layout_width="191mm"
            android:layout_height="55mm"
            android:background="@drawable/r_button_bg"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:textSize="21mm"
            android:fontFamily="@font/montserrat_regular"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="@string/turn_on"/>

        <LinearLayout
            android:id="@+id/linear_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:gravity="center">

            <ImageView
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:src="@drawable/ic_checked_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginLeft="14mm"
                android:textSize="23mm"
                android:textColor="@color/colorAccent"
                android:text="@string/current"/>
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_yellow"
        android:layout_width="match_parent"
        android:layout_height="103mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginTop="20mm"
        android:paddingLeft="24mm"
        android:paddingRight="24mm"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_2"
            android:layout_width="31mm"
            android:layout_height="31mm"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_light_strip"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/iv_2"
            android:layout_marginLeft="24mm"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="25mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/light_yellow"/>

        <Button
            android:id="@+id/bt_yellow"
            android:layout_width="191mm"
            android:layout_height="55mm"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/r_button_bg"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/turn_on"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21mm" />

        <LinearLayout
            android:id="@+id/linear_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:gravity="center">

            <ImageView
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:src="@drawable/ic_checked_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginLeft="14mm"
                android:textSize="23mm"
                android:textColor="@color/colorAccent"
                android:text="@string/current"/>
        </LinearLayout>
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/relative_green"
        android:layout_width="match_parent"
        android:layout_height="103mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginTop="20mm"
        android:paddingLeft="24mm"
        android:paddingRight="24mm"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_3"
            android:layout_width="31mm"
            android:layout_height="31mm"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_light_strip"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/iv_3"
            android:layout_marginLeft="24mm"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="25mm"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/light_green"/>

        <Button
            android:id="@+id/bt_green"
            android:layout_width="191mm"
            android:layout_height="55mm"
            android:background="@drawable/r_button_bg"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:textSize="21mm"
            android:fontFamily="@font/montserrat_regular"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="@string/turn_on"/>

        <LinearLayout
            android:id="@+id/linear_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:gravity="center">

            <ImageView
                android:layout_width="31mm"
                android:layout_height="31mm"
                android:src="@drawable/ic_checked_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginLeft="14mm"
                android:textSize="23mm"
                android:textColor="@color/colorAccent"
                android:text="@string/current"/>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>