<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorMain"
    tools:context=".ui.activity.Jar101Activity">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104mm"
        tools:ignore="MissingConstraints" />

    <RelativeLayout
        android:id="@+id/relative_light"
        android:layout_width="match_parent"
        android:layout_height="103mm"
        android:layout_marginLeft="30mm"
        android:layout_marginRight="30mm"
        android:layout_marginTop="12mm"
        android:paddingLeft="24mm"
        android:paddingRight="24mm"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_4"
            android:layout_width="31mm"
            android:layout_height="31mm"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_light_strip"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24mm"
            android:layout_toRightOf="@+id/iv_4"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/light_strips"
            android:textColor="@color/white"
            android:textSize="25mm" />

        <ImageView
            android:layout_width="51mm"
            android:layout_height="51mm"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow"/>
    </RelativeLayout>

</LinearLayout>