<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_mode_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/save_image_matrix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35mm"
            android:layout_marginTop="25mm"
            android:fontFamily="@font/montserrat_semibold"
            android:text="@string/Video_Test"
            android:textColor="@color/white"
            android:textSize="25mm" />

        <TextView
            android:textColor="@color/colorMainButton"
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginTop="25mm"
            android:fontFamily="@font/montserrat_semibold"
            android:layout_marginRight="55mm"
            android:textSize="25mm" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_marginTop="15mm"
        android:layout_centerInParent="true"
        android:layout_below="@id/save_image_matrix"
        android:id="@+id/container_video"
        android:layout_width="520mm"
        android:layout_height="280mm"
        >

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

    </RelativeLayout>

</RelativeLayout>