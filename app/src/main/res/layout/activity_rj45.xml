<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/network_name"
            android:textColor="@color/white"
            android:textSize="37dp" />


    </RelativeLayout>

    <LinearLayout
        android:id="@+id/image_name"
        android:layout_width="772dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        tools:ignore="MissingConstraints,WebViewLayout">

        <TextView
            android:textSize="25dp"
            android:textColor="@color/white"
            android:text="@string/Below_testing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <WebView
            android:layout_marginTop="24dp"
            android:id="@+id/full_webView"
            android:layout_width="772dp"
            android:layout_height="435dp"
            android:layerType="hardware"
            tools:ignore="InOrdpUsage" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_title_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginTop="30dp"
        android:text="@string/expected_Passed"
        android:textColor="@color/white"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_name" />

    <RelativeLayout
        android:layout_width="870dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_name"
        tools:ignore="InOrdpUsage,MissingConstraints">


        <Button
            android:id="@+id/failure_bu"
            android:layout_width="121dp"
            android:layout_height="55dp"
            android:background="@drawable/r_button_bg"
            android:text="@string/Failed"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21dp"
            tools:ignore="InOrdpUsage" />


        <Button
            android:id="@+id/through_bu"
            android:layout_width="121dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/Passed"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21dp"
            tools:ignore="InOrdpUsage" />


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>