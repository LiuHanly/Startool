<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:color_picker="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@drawable/selector_mode_bg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="38dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_light_strip"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textSize="25dp"
                android:textColor="@color/white"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/light_strips"/>
        </LinearLayout>


        <ImageView
            android:id="@+id/iv_light"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginRight="40dp"
            android:layout_gravity="right"
            android:src="@drawable/ic_light_off"/>

        <com.glorystar.startool.utils.tool.ColorPickerView
            android:id="@+id/color_pick_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            color_picker:center_color="#000000"
            color_picker:center_radius="8dp"
            color_picker:circle_radius="110dp"
            color_picker:wheel_radius="116dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="42dp"
            android:layout_marginRight="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_color_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:text="Classic"/>

            <TextView
                android:id="@+id/tv_red"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/color_red"/>

            <TextView
                android:id="@+id/tv_yellow"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/color_yellow"/>

            <TextView
                android:id="@+id/tv_green"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/color_green"/>

            <TextView
                android:id="@+id/tv_qing"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/color_qing"/>

            <TextView
                android:id="@+id/tv_white"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/color_white"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="40dp"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="45dp"
            android:fontFamily="@font/montserrat_regular"
            android:textStyle="bold"
            android:textSize="21dp"
            android:textColor="@color/colorMainButton"
            android:text="@string/go_back"/>
    </LinearLayout>
</RelativeLayout>