<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.OtaActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:layout_width="870dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/selector_mode_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:src="@drawable/ic_ota"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:textSize="25dp"
                android:text="@string/ota_update"
                android:textColor="@color/white"
                android:fontFamily="@font/montserrat_regular"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <EditText
                android:id="@+id/edt_input"
                android:layout_width="match_parent"
                android:layout_height="79dp"
                android:paddingLeft="24dp"
                android:fontFamily="@font/montserrat_regular"
                android:textSize="25dp"
                android:background="@drawable/edit_bg"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/colorFont"
                android:textColorHint="@color/colorFont"
                android:hint="@string/ota_input_tip"
                android:imeOptions="actionDone"/>

            <LinearLayout
                android:id="@+id/linear_success"
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:layout_gravity="right|center_vertical"
                android:background="@drawable/selector_mode_bg"
                android:layout_marginRight="2dp"
                android:paddingRight="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:src="@drawable/ic_success"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/package_downloaded"
                    android:layout_marginLeft="14dp"
                    android:textSize="23dp"
                    android:textColor="@color/colorAccent"
                    android:fontFamily="@font/montserrat_regular" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_gravity="right"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:focusableInTouchMode="true"
            android:focusable="true">

            <Button
                android:id="@+id/bt_download"
                android:layout_width="251dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:textStyle="bold"
                android:textSize="21dp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:text="@string/ota_download"/>

            <TextView
                android:id="@+id/tv_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="42dp"
                android:fontFamily="@font/montserrat_regular"
                android:textStyle="bold"
                android:textSize="21dp"
                android:textColor="@color/colorMainButton"
                android:text="@string/ota_clear"/>

            <Button
                android:id="@+id/bt_verify"
                android:layout_width="251dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:textStyle="bold"
                android:textSize="21dp"
                android:layout_marginLeft="24dp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:text="@string/verify_package"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>