<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="365dp"
    app:cardBackgroundColor="@color/colorEmpty"
    app:cardCornerRadius="30dp">

    <LinearLayout

        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_mode_bg">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="35dp"
                android:layout_marginTop="25dp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="@string/EMMCTest"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <TextView
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="25dp"
                android:layout_marginRight="55dp"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/colorMainButton"
                android:textSize="25dp" />

        </RelativeLayout>

        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingTop="24dp"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp">

                <com.github.lzyzsd.circleprogress.DonutProgress
                    android:id="@+id/pgr_freq"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:donut_finished_color="@color/colorMainButton"
                    app:donut_finished_stroke_width="4dp"
                    app:donut_progress="30"
                    app:donut_show_text="false"
                    app:donut_unfinished_color="@color/colorAccentLight"
                    app:donut_unfinished_stroke_width="4dp" />

                <RelativeLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="@string/Free_Memory"
                            android:textColor="@color/white"
                            android:textSize="23dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">


                            <com.glorystar.startool.ui.view.DincondFontTextView
                                android:id="@+id/tv_freq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:textColor="@color/white"

                                android:textSize="37dp"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_above="@id/tv_freq"
                                android:layout_centerHorizontal="true"
                                android:text="@string/cpu_test_cur_freq"
                                android:textColor="@color/white"
                                android:textSize="35dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tv_freq"
                                android:layout_centerHorizontal="true"
                                android:text="MB"
                                android:textColor="@color/white"
                                android:textSize="25dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_freq_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/colorFont"
                                android:textSize="23dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="MB"
                                android:textColor="@color/colorFont"
                                android:textSize="23dp" />

                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>