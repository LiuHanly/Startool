<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="684dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:text="@string/sender_output_title"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="25dp"
            android:text="@string/sender_output_detail"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="36dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp">

            <EditText
                android:id="@+id/edt_input_hid"
                android:layout_width="wrap_content"
                android:layout_height="79dp"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:paddingLeft="24dp"
                android:fontFamily="@font/montserrat_regular"
                android:textSize="25dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="3"
                android:textColor="@color/colorFont"
                android:textColorHint="@color/colorFont"
                android:hint="@string/sender_hid_tip"
                android:imeOptions="actionDone"/>

            <EditText
                android:id="@+id/edt_input_pid"
                android:layout_width="wrap_content"
                android:layout_height="79dp"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:paddingLeft="24dp"
                android:fontFamily="@font/montserrat_regular"
                android:textSize="25dp"
                android:background="@drawable/edit_bg"
                android:inputType="number"
                android:singleLine="true"
                android:maxLength="5"
                android:textColor="@color/colorFont"
                android:textColorHint="@color/colorFont"
                android:hint="@string/sender_pid_tip"
                android:imeOptions="actionDone"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="right|bottom"
            android:layout_marginTop="84dp"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="30dp">

            <Button
                android:id="@+id/bt_send"
                android:layout_width="159dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:textStyle="bold"
                android:textSize="21dp"
                android:textColor="@color/white"
                android:text="@string/send_now"
                android:textAllCaps="false"/>

            <TextView
                android:id="@+id/tv_go_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="42dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/go_back"
                android:textColor="@color/colorMainButton"
                android:textSize="21dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relative_help"
        android:layout_width="930dp"
        android:layout_height="77dp"
        android:layout_marginBottom="30dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:background="@drawable/selector_mode_bg">

        <ImageView
            android:id="@+id/iv_help"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_help" />

        <TextView
            android:id="@+id/tv_input_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/iv_help"
            android:textSize="23dp"
            android:text="@string/sender_output_tip"
            android:textColor="@color/white"/>
    </LinearLayout>
</RelativeLayout>