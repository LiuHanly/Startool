<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Photo_test"
            android:textColor="@color/white"
            android:textSize="37dp" />

    </RelativeLayout>

    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="312dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2">
        <TextView
            android:text="@string/expected_Passed"
            style="@style/text_style"
            android:layout_marginBottom="48dp"
            />

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints">


            <Button
                android:id="@+id/failure_bu"
                android:layout_width="121dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:text="@string/Failed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp"
                tools:ignore="InOrdpUsage" />

            <TextView
                android:id="@+id/redo_bu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/Restart"
                android:textColor="@color/colorMainButton"
                android:textSize="21dp" />


            <Button
                android:id="@+id/through_bu"
                android:layout_width="121dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/r_button_bg"
                android:text="@string/Passed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp"
                tools:ignore="InOrdpUsage" />


        </RelativeLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>