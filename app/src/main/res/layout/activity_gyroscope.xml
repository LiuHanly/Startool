<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/gyroscope_name"
            android:textColor="@color/white"
            android:textSize="37dp" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="772dp"
            android:layout_height="435dp"
            android:background="@drawable/selector_mode_bg">

            <ImageView
                android:layout_marginLeft="60dp"
                android:id="@+id/image1"
                android:layout_width="118dp"
                android:layout_height="294dp"
                android:layout_centerVertical="true"
                android:src="@mipmap/arrow_left" />

            <ImageView
                android:layout_width="294dp"
                android:layout_height="294dp"
                android:layout_centerInParent="true"
                android:src="@mipmap/device" />

            <ImageView
                android:layout_marginRight="60dp"
                android:id="@+id/image2"
                android:layout_width="118dp"
                android:layout_height="294dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/arrow_right" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/expected_Passed"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            tools:ignore="MissingConstraints">


            <Button
                android:id="@+id/failure_bu"
                android:layout_width="121dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:text="@string/Failed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp"
                tools:ignore="InOrdpUsage" />


            <Button
                android:id="@+id/through_bu"
                android:layout_width="121dp"
                android:layout_height="55dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/r_button_bg"
                android:text="@string/Passed"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp"
                tools:ignore="InOrdpUsage" />


        </RelativeLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>