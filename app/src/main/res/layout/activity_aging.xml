<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104dp" />

    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tile_view"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="120dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tile_view">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/through"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/performace"
            android:textColor="@color/white"
            android:textSize="25dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:layout_marginTop="60dp"
        android:gravity="center"
       >

        <RelativeLayout
            android:layout_weight="1"
            android:id="@+id/preaging_relat"
            style="@style/linear_aging"
            android:layout_marginRight="30dp">

            <ImageView
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="36dp"
                android:src="@mipmap/testbefore" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="36dp"
                android:text="@string/preaging"
                android:textColor="@color/white"
                android:textSize="37dp" />


        </RelativeLayout>

        <RelativeLayout
            android:layout_weight="1"
            android:id="@+id/aging_relat"
            style="@style/linear_aging"
            android:layout_marginRight="30dp">

            <ImageView
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="36dp"
                android:src="@mipmap/testxxxhdpi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="36dp"
                android:text="@string/Aging"
                android:textColor="@color/white"
                android:textSize="37dp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_weight="1"
            android:id="@+id/text_post"
            style="@style/linear_aging">

            <ImageView
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="36dp"
                android:src="@mipmap/testafter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="36dp"
                android:text="@string/postagingtest"
                android:textColor="@color/white"
                android:textSize="37dp" />
        </RelativeLayout>

    </LinearLayout>


</LinearLayout>