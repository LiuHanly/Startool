<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    tools:context=".ui.activity.TestReportActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68mm"
        android:layout_marginTop="28mm"
        android:textColor="@color/white"
        android:textSize="35mm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/recyclerView2"
        android:layout_width="900mm"
        android:layout_height="wrap_content"
        android:layout_marginStart="32mm"
        android:layout_marginTop="64mm"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <RelativeLayout
            android:layout_marginTop="25mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="50mm"
                android:text="@string/DATE"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/TIME"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/Serial_number"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/Model"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/Android_version"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/Build_number"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="50mm"
                android:text="DDR ："
                android:textColor="@color/white"
                android:textSize="25mm"
                tools:layout_editor_absoluteX="14mm"
                tools:layout_editor_absoluteY="59mm" />

            <TextView
                android:id="@+id/Inter_shared_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/MAC"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5mm"
            android:layout_marginLeft="25mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="50mm"
            android:layout_marginBottom="15mm"
            android:background="@color/white" />

        <RelativeLayout
            android:layout_marginBottom="25mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25mm"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginRight="50mm"
                android:text="@string/INTERSHAREDSTORAGE"
                android:textColor="@color/white"
                android:textSize="25mm" />

            <TextView
                android:id="@+id/Serial_number5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginRight="50mm"
                android:textColor="@color/white"
                android:textSize="25mm" />

        </RelativeLayout>


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:padding="15mm"
        android:id="@+id/recyclerView"
        android:layout_width="700mm"
        android:layout_height="wrap_content"
        android:layout_marginStart="36mm"
        android:background="@drawable/selector_mode_bg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toEndOf="@+id/recyclerView2"
        app:layout_constraintTop_toTopOf="@+id/textView2" />


</androidx.constraintlayout.widget.ConstraintLayout>