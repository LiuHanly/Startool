<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_buttons"/>

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:text="@string/buttons"/>
        </LinearLayout>

        <EditText
            android:id="@+id/edt_output"
            android:layout_width="match_parent"
            android:layout_height="79dp"
            android:layout_marginTop="60dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:paddingLeft="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:textSize="25dp"
            android:background="@drawable/edit_bg"
            android:focusable="false"
            android:textColor="@color/colorFont"
            android:textColorHint="@color/colorFont"
            android:hint="@string/buttons_tip" />

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="93dp"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="45dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21dp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>