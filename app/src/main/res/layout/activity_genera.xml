<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/relative_device_info"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_1"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_device_info" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_1"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/device_info"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <ImageView
                    android:layout_width="51dp"
                    android:layout_height="51dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_ota"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_2"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ota" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_2"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/ota_update"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <ImageView
                    android:layout_width="51dp"
                    android:layout_height="51dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_brightness"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_3"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_brightness" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_3"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/screen_brightness"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_1"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/set"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />

                <Button
                    android:id="@+id/bt_brightness_get"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="24dp"
                    android:layout_toLeftOf="@+id/bt_1"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/get"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_volume"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_4"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_volume" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_4"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/volume"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_2"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/set"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />

                <Button
                    android:id="@+id/bt_volume_get"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="24dp"
                    android:layout_toLeftOf="@+id/bt_2"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/get"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_orientation"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_5"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_orientation" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_5"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/orientation"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_orientation_get"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/get"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_change_orientation"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_8"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_orientation" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_8"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/change_orientation"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_portrait"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/portrait"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />

                <Button
                    android:id="@+id/bt_landscape"
                    android:layout_width="150dp"
                    android:layout_height="55dp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="24dp"
                    android:layout_toLeftOf="@+id/bt_portrait"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/landscape"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_screenshot"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_6"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_screenshot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_6"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/screenshot"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_screenshot"
                    android:layout_width="191dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/take"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_reboot"
                android:layout_width="870dp"
                android:layout_height="103dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/selector_mode_bg"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <ImageView
                    android:id="@+id/iv_7"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_restart" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="24dp"
                    android:layout_toRightOf="@+id/iv_7"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/reboot_device"
                    android:textColor="@color/white"
                    android:textSize="25dp" />

                <Button
                    android:id="@+id/bt_reboot"
                    android:layout_width="191dp"
                    android:layout_height="55dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/r_button_bg"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="@string/reboot"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="21dp" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>