<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="79mm"
    android:layout_marginTop="14mm"
    android:background="@drawable/selector_mode_bg"
    >

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="31mm"
        android:layout_height="31mm"
        android:layout_centerVertical="true"
        android:layout_marginStart="15mm"
        android:layout_marginTop="15mm"
        android:layout_marginEnd="15mm"
        android:layout_marginBottom="15mm" />

    <TextView
        android:id="@+id/tv_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="18mm"
        android:layout_toRightOf="@id/iv_icon"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="main text"
        android:textColor="@color/white"
        android:textSize="25mm" />

</RelativeLayout>