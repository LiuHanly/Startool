<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/selector_mode_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/ic_sensor" />

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/sensors"
                android:textColor="@color/white"
                android:textSize="25dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/proximity_output"
            android:textColor="@color/colorFont"
            android:textSize="23dp" />

        <TextView
            android:id="@+id/tv_proximity_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="37dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/ambient_output"
            android:textColor="@color/colorFont"
            android:textSize="23dp" />

        <TextView
            android:id="@+id/tv_ambient_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_regular"
            android:textColor="@color/white"
            android:textSize="37dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="99dp"
            android:layout_marginRight="42dp"
            android:layout_marginBottom="45dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/go_back"
            android:textColor="@color/colorMainButton"
            android:textSize="21dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/relative_help"
        android:layout_width="930dp"
        android:layout_height="77dp"
        android:layout_marginBottom="20dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:background="@drawable/selector_mode_bg">

        <ImageView
            android:id="@+id/iv_help"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/iv_help"
            android:textSize="23dp"
            android:text="@string/sensor_tip"
            android:textColor="@color/white"/>
    </LinearLayout>
</RelativeLayout>