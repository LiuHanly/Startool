<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.VegaActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/relative_relay"
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_1"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/relay"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <ImageView
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_wiegand"
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_2"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_2"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/wiegand_interface"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <ImageView
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_3"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_3"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/rs485"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_485"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textSize="21dp"
                android:fontFamily="@font/montserrat_regular"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:text="@string/open_port"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_4"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_gpio"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_4"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/input_prot"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_input"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_5"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_camera"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_5"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/camera"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_camera"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_6"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_sensor"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_6"
                android:layout_marginLeft="24dp"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/sensors"/>

            <Button
                android:id="@+id/bt_sensor"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_7"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_rfid"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_7"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/rfid"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_rfid"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>