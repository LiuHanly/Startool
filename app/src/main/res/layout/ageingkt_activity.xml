<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="116mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/Aging"
            android:textColor="@color/white"
            android:textSize="37mm" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">


        <fragment
            android:id="@+id/cpuframe"
            android:name="com.glorystar.startool.ui.fragment.CPUKtTestFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="35mm"
            android:layout_marginTop="35mm"
            android:layout_marginRight="15mm"
            android:layout_marginBottom="15mm"
            android:layout_weight="1" />

        <fragment
            android:id="@+id/emmcFrame"
            android:name="com.glorystar.startool.ui.fragment.MemoryTestKtFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15mm"
            android:layout_marginTop="35mm"
            android:layout_marginRight="35mm"
            android:layout_marginBottom="15mm"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <fragment
            android:id="@+id/ddrFrame"
            android:name="com.glorystar.startool.ui.fragment.DDRTestKtFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="35mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="15mm"
            android:layout_marginBottom="35mm"
            android:layout_weight="1" />

        <fragment
            android:id="@+id/videoFrame"
            android:name="com.glorystar.startool.ui.fragment.VideoTestKtFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15mm"
            android:layout_marginTop="15mm"
            android:layout_marginRight="35mm"
            android:layout_marginBottom="35mm"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>