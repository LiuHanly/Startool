<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    tools:context=".ui.activity.GpioActivity">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/GpIO_name_test"
            android:textColor="@color/white"
            android:textSize="37dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/RelativeL01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2">

        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_gpio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_1"
                android:fontFamily="@font/montserrat_regular"
                android:text="GPIO 1"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_gpio1_close"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/gpio_close"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />

            <Button
                android:id="@+id/bt_gpio1_open"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="24dp"
                android:layout_toLeftOf="@+id/bt_gpio1_close"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/gpio_open"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <ImageView
                android:id="@+id/iv_2"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_gpio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_2"
                android:fontFamily="@font/montserrat_regular"
                android:text="GPIO 2"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_gpio2_close"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/gpio_close"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />

            <Button
                android:id="@+id/bt_gpio2_open"
                android:layout_width="150dp"
                android:layout_height="55dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="24dp"
                android:layout_toLeftOf="@+id/bt_gpio2_close"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/gpio_open"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relative_uart"
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <ImageView
                android:id="@+id/iv_32"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chips" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_32"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/uart"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_uart"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/open_port"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relative_wiegand"
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/selector_mode_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <ImageView
                android:id="@+id/iv_31"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chips" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_31"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/wiegand_interface"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_uart1"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/r_button_bg"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/open_port"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="21dp" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="870dp"
            android:layout_height="103dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:background="@drawable/selector_mode_bg">
            <ImageView
                android:id="@+id/iv_3"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:src="@drawable/ic_chips"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:layout_toRightOf="@+id/iv_3"
                android:fontFamily="@font/montserrat_regular"
                android:text="@string/rs485"
                android:textColor="@color/white"
                android:textSize="25dp" />

            <Button
                android:id="@+id/bt_485"
                android:layout_width="191dp"
                android:layout_height="55dp"
                android:background="@drawable/r_button_bg"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textSize="21dp"
                android:fontFamily="@font/montserrat_regular"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:text="@string/open_port"/>
        </RelativeLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="870dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/RelativeL01"
        tools:ignore="MissingConstraints">


        <Button
            android:id="@+id/through_bu"
            android:layout_width="121dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/r_button_bg"
            android:text="@string/NEXTBUTTON"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21dp"
            tools:ignore="InOrdpUsage" />


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>