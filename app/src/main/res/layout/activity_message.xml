<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain">

    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="116mm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/device_infor"
            android:textColor="@color/white"
            android:textSize="37mm" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2"
        app:layout_constraintVertical_bias="0.149">

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/Screen_number" />

            <TextView
                android:id="@+id/Serial_number"
                style="@style/text_style_right" />

        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/Model_name" />

            <TextView
                style="@style/text_style_right"
                android:id="@+id/Model"
                />
        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/Android_version" />

            <TextView
                style="@style/text_style_right"
                android:id="@+id/Android_version"/>
        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/Build_version" />

            <TextView style="@style/text_style_right"
                android:id="@+id/Build_number"
                />
        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/MAC" />

            <TextView style="@style/text_style_right"
                android:id="@+id/IP_address"
                />
        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/DDR" />

            <TextView style="@style/text_style_right"
                android:id="@+id/Inter_shared_storage"
                />
        </RelativeLayout>

        <RelativeLayout style="@style/device_relative">

            <TextView
                style="@style/text_style"
                android:text="@string/Menory" />

            <TextView style="@style/text_style_right"
                android:id="@+id/Inter_storage"
                />
        </RelativeLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>