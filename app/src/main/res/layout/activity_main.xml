<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMain"
    android:orientation="vertical"

    tools:context=".ui.activity.MainActivity"
    tools:ignore="InOrMmUsage">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="116mm"
        android:layout_alignParentEnd="true"
        android:paddingLeft="24mm"
        android:paddingRight="24mm"
        tools:ignore="InOrMmUsage,MissingConstraints">

        <LinearLayout
            android:id="@+id/title_linear"
            android:layout_width="wrap_content"
            android:layout_height="116mm"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingEnd="70mm"
            tools:ignore="RtlSymmetry,UseCompoundDrawables,UselessParent">

            <ImageView

                android:layout_width="36mm"
                android:layout_height="36mm"
                android:layout_marginEnd="24mm"
                android:contentDescription="TODO"
                android:padding="4mm"
                android:src="@drawable/ic_info" />

            <TextView
                android:id="@+id/textlanguage"
                android:layout_width="44mm"
                android:layout_height="44mm"
                android:gravity="center"
                android:text="@string/language"
                android:textColor="@color/white"
                android:textSize="25mm" />
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24mm"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logo_startoo"
            android:layout_width="686mm"
            android:layout_height="369mm"

            android:contentDescription="TODO"
            android:src="@mipmap/startoolslogo"
            tools:ignore="InOrMmUsage,NotSibling" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70mm"
            android:gravity="center"
            android:text="@string/select"
            android:textColor="@color/colorFont"
            android:textSize="23mm"
            tools:ignore="InOrMmUsage" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="20mm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingLeft="88mm"
        android:paddingRight="88mm"
        android:paddingBottom="61mm"
        tools:ignore="InOrMmUsage">

        <androidx.cardview.widget.CardView
            android:layout_width="400mm"
            android:layout_height="359mm"
            android:layout_marginEnd="48mm"
            android:background="@color/colorMainLight"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            app:cardBackgroundColor="@color/colorMainLight"
            app:cardCornerRadius="11mm">

            <RelativeLayout
                android:id="@+id/Enter_General"
                style="@style/home_tile_relative"
                tools:ignore="InOrMmUsage">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30mm"
                    android:orientation="vertical">

                    <LinearLayout

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/General"
                            android:textColor="@color/white"
                            android:textSize="25mm" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24mm"
                        android:text="@string/General_masg"
                        android:textColor="@color/colorFont"
                        android:textSize="23mm" />

                </LinearLayout>

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Enter"
                        android:textColor="@color/white"
                        android:textSize="25mm" />

                </LinearLayout>


            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="400mm"
            android:layout_height="359mm"
            android:layout_marginEnd="48mm"
            android:background="@color/colorMainLight"
            android:paddingLeft="24mm"
            android:paddingRight="24mm"
            app:cardBackgroundColor="@color/colorMainLight"
            app:cardCornerRadius="11mm">

            <RelativeLayout
                android:id="@+id/Enter_Model"
                style="@style/home_tile_relative"
                tools:ignore="InOrMmUsage">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30mm"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Model"
                            android:textColor="@color/white"
                            android:textSize="25mm" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24mm"
                        android:text="@string/Model_masg"
                        android:textColor="@color/colorFont"
                        android:textSize="23mm" />

                </LinearLayout>
                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Enter"
                        android:textColor="@color/white"
                        android:textSize="25mm" />

                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="400mm"
            android:layout_height="359mm"
            android:layout_marginEnd="48mm"
            android:background="@color/colorMainLight"
            app:cardBackgroundColor="@color/colorMainLight"
            app:cardCornerRadius="11mm">

            <RelativeLayout
                android:id="@+id/Enter_Addon"
                style="@style/home_tile_relative"
                tools:ignore="InOrMmUsage">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30mm"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Addon"
                            android:textColor="@color/white"
                            android:textSize="25mm" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24mm"
                        android:text="@string/Addon_masg"
                        android:textColor="@color/colorFont"
                        android:textSize="23mm" />

                </LinearLayout>
                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Enter"
                        android:textColor="@color/white"
                        android:textSize="25mm" />

                </LinearLayout>
            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="400mm"
            android:layout_height="359mm"
            android:background="@color/colorMainLight"
            app:cardBackgroundColor="@color/colorMainLight"
            app:cardCornerRadius="11mm">

            <RelativeLayout
                android:id="@+id/Enter_Aging"
                style="@style/home_tile_relative"
                tools:ignore="InOrMmUsage">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30mm"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Aging"
                            android:textColor="@color/white"
                            android:textSize="25mm" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24mm"
                        android:text="@string/Aging_masg"
                        android:textColor="@color/colorFont"
                        android:textSize="23mm" />

                </LinearLayout>

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Enter"
                        android:textColor="@color/white"
                        android:textSize="25mm" />

                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>


</LinearLayout>