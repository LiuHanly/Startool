<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.BarcodeModulesActivity"
    android:background="@color/colorMain">

    <com.glorystar.startool.ui.view.TitleKtView
        android:id="@+id/tile_view"
        android:layout_width="match_parent"
        android:layout_height="104dp" />

    <RelativeLayout
        android:id="@+id/relative_barcode_honeywell"
        android:layout_width="870dp"
        android:layout_height="103dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_1"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_barcode"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24dp"
            android:layout_toRightOf="@+id/iv_1"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/honeywell_n4680"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <ImageView
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_barcode_newland"
        android:layout_width="870dp"
        android:layout_height="103dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_2"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_barcode"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24dp"
            android:layout_toRightOf="@+id/iv_2"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/newland_em3396"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <ImageView
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_barcode_zebra"
        android:layout_width="870dp"
        android:layout_height="103dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_3"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_barcode"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24dp"
            android:layout_toRightOf="@+id/iv_3"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/zebra_se2707"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <ImageView
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_ld_newland"
        android:layout_width="870dp"
        android:layout_height="103dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="12dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:background="@drawable/selector_mode_bg">
        <ImageView
            android:id="@+id/iv_4"
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_barcode"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="24dp"
            android:layout_toRightOf="@+id/iv_4"
            android:fontFamily="@font/montserrat_regular"
            android:text="@string/newland_em1365"
            android:textColor="@color/white"
            android:textSize="25dp" />

        <ImageView
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow"/>
    </RelativeLayout>
</LinearLayout>