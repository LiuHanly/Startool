<?xml version="1.0" encoding="utf-8"?>
<shape
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内部颜色 -->
    <solid
        android:color="@color/colorMainLight" />
    <!-- 边缘线条颜色 -->
    <stroke
    android:width="1dp"
    android:color="@color/colorMainLight" />
    <!-- 图形大小 -->
    <size android:height="4mm"/>
    <!-- 圆角的幅度 -->
    <corners
        android:bottomRightRadius="11dp"
        android:topLeftRadius="11dp"
        android:radius="11mm"/>

</shape>