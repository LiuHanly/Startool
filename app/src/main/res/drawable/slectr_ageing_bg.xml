<?xml version="1.0" encoding="utf-8"?>
<shape
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内部颜色 -->
    <solid
        android:color="@color/colorEmpty" />
    <!-- 边缘线条颜色 -->
    <stroke
        android:width="3dp"
        android:color="@color/black" />
    <!-- 图形大小 -->
    <size android:height="4dp"/>
    <!-- 圆角的幅度 -->
    <corners
        android:radius="20dp"/>

</shape>