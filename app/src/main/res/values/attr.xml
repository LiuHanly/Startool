<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--  自定义的属性值  -->
    <!--  设置全局字体大小，有需要可以再继续添加。  -->
    <attr name="fontSize_BodyMini" format="dimension" />
    <attr name="fontSize_BodySmall" format="dimension" />
    <attr name="fontSize_BodyMiddle" format="dimension" />
    <attr name="fontSize_Body" format="dimension" />
    <attr name="fontSize_Title" format="dimension" />
    <attr name="fontSize_TitleLarge" format="dimension" />
    <attr name="fontSize_TitleBig" format="dimension" />

    <!-- 自定义标题TitleView，标题属性 -->
    <declare-styleable name="TitleAttr">
        <attr name="title_name" format="reference|string" />
        <attr name="title_text_color" format="reference|color" />
        <attr name="title_text_size" format="reference|dimension" />
        <attr name="title_drawable_right" format="reference" />
        <attr name="title_drawable_left" format="reference" />
        <attr name="title_height" format="dimension" />
        <attr name="title_gravity">
            <enum name="left" value="3" />
            <enum name="center" value="17" />
            <enum name="right" value="5" />
        </attr>
        <attr name="title_textStyle">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
        </attr>
        <attr name="left_image" format="reference" />
        <attr name="small_text_color" format="reference|color" />
        <attr name="small_text_size" format="reference|dimension" />
        <attr name="left_text" format="reference|string" />
        <attr name="left_text_drawable_right" format="reference" />
        <attr name="left_text_drawable_left" format="reference" />
        <attr name="right_image" format="reference" />
        <attr name="right_image_two" format="reference" />
        <attr name="right_text" format="reference|string" />
        <attr name="right_text_two" format="reference|string" />
        <attr name="right_text_drawable_right" format="reference" />
        <attr name="right_text_drawable_left" format="reference" />
        <attr name="right_text_two_drawable_right" format="reference" />
        <attr name="right_text_two_drawable_left" format="reference" />
        <attr name="right_image_margins_right" format="dimension" />
    </declare-styleable>

    <!--  状态栏高度View,用于沉浸占位  -->
    <declare-styleable name="StatusBarHeightView">
        <attr name="use_type" format="integer">
            <enum name="use_height" value="0" />
            <enum name="use_padding_top" value="1" />
        </attr>
    </declare-styleable>

    <!--  带有刻度的圆形进度条  -->
    <declare-styleable name="DialProgress">
        <attr name="antiAlias" format="boolean" /><!-- 是否开启抗锯齿 -->
        <attr name="startAngle" format="float" /><!-- 圆弧起始角度，3点钟方向为0，顺时针递增，小于0或大于360进行取余 -->
        <attr name="sweepAngle" format="float" /><!-- 圆弧度数 -->
        <attr name="animTime" format="integer" /><!-- 设置动画时间 -->
        <attr name="maxValue" format="float" /><!-- 绘制内容的数值 -->
        <attr name="value" format="float" />
        <!-- 精度，默认为0 -->
        <attr name="precision" format="integer" />
        <attr name="valueSize" format="dimension" />
        <attr name="valueColor" format="color|reference" />
        <attr name="textOffsetPercentInRadius" format="float" /><!-- 文字的偏移量。相对于圆半径而言，默认三分之一 -->
        <!-- 绘制内容的单位 -->
        <attr name="unit" format="string|reference" />
        <attr name="unitSize" format="dimension" />
        <attr name="unitColor" format="color|reference" />
        <!-- 绘制内容相应的提示语 -->
        <attr name="hint" format="string|reference" />
        <attr name="hintSize" format="dimension" />
        <attr name="hintColor" format="color|reference" />
        <!-- 圆弧的宽度 -->
        <attr name="arcWidth" format="dimension" />
        <!-- 刻度的宽度 -->
        <attr name="dialWidth" format="dimension|reference" />
        <!-- 刻度之间的间隔 -->
        <attr name="dialIntervalDegree" format="integer" />
        <!-- 圆弧颜色， -->
        <attr name="arcColors" format="color|reference" />
        <!-- 背景圆弧线颜色 -->
        <attr name="bgArcColor" format="color|reference" />
        <!-- 刻度线颜色 -->
        <attr name="dialColor" format="color|reference" />
    </declare-styleable>
    <!-- 圆弧颜色，设置多个可实现渐变 -->
    <attr name="arcColor1" format="color|reference" />
    <attr name="arcColor2" format="color|reference" />
    <attr name="arcColor3" format="color|reference" />

    <!--  统计图表  -->
    <declare-styleable name="suitlines">
        <attr name="xySize" format="float" />
        <attr name="xyColor" format="reference|color" />
        <attr name="lineType">
            <enum name="curve" value="0" />
            <enum name="segment" value="1" />
        </attr>
        <attr name="lineStyle">
            <enum name="solid" value="0" />
            <enum name="dashed" value="1" />
        </attr>
        <attr name="needEdgeEffect" format="boolean" />
        <attr name="colorEdgeEffect" format="reference|color" />
        <attr name="needClickHint" format="boolean" />
        <attr name="colorHint" format="reference|color" />
        <attr name="maxOfVisible" format="integer" />
        <attr name="countOfY" format="integer" />
    </declare-styleable>

    <!--  梯形统计图表  -->
    <declare-styleable name="LadderTextView">
        <attr name="textContent" format="string"/>
        <attr name="offsetScale" format="float"/>
        <attr name="isLeft" format="boolean"/>
        <attr name="isRight" format="boolean"/>
        <attr name="isSelected" format="boolean"/>
        <attr name="selectedColor" format="color|reference"/>
        <attr name="strokeWidthLadder" format="dimension"/>
    </declare-styleable>

    <!--职位标记-->
    <declare-styleable name="BorderLabelTextView">
        <!--边框的宽度，默认为1dp-->
        <attr name="strokeWidth" format="dimension" />
        <!--圆角半径，默认为2dp-->
        <attr name="cornerRadius" format="dimension" />
        <!--边框颜色，默认是没有边框即颜色为Color.TRANSPARENT-->
        <attr name="strokeColor" format="color" />
        <!--边框是否跟随文字颜色，默认是true-->
        <attr name="followTextColor" format="boolean" />
        <!--实心或空心，默认空心-->
        <attr name="isSolid" format="boolean" />
    </declare-styleable>
    <declare-styleable name="TagFlowLayout">
        <attr name="max_select" format="integer"></attr>
        <attr name="tag_gravity">
            <enum name="left" value="-1" />
            <enum name="center" value="0" />
            <enum name="right" value="1" />
        </attr>
    </declare-styleable>



</resources>
