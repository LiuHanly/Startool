<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.StarTool" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="NoTitle.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="NoTitle.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- activity 状态栏设置theme. -->
    <style name="NoTitle" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorMain</item>
        <item name="colorPrimaryDark">@color/colorMain</item>
        <item name="colorAccent">@color/colorMain</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:textAppearanceListItemSmall">@style/listPopupWindow</item>
    </style>

    <!-- 继承自你的 NoTitle，但把引发 WebView 崩溃的属性清空 -->
    <style name="NoTitleForWebView" parent="NoTitle">
        <!-- 强行清除此处的弹窗干扰，恢复系统默认样式 -->
        <item name="android:textAppearanceListItemSmall">@android:style/TextAppearance.Material.Subhead</item>
    </style>
    <!-- activity 状态栏设置theme. -->
    <style name="NoTitletow" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/colorMain</item>
        <item name="colorPrimary">@color/colorMain</item>
        <item name="colorPrimaryDark">@color/colorMain</item>
        <item name="colorAccent">@color/colorMain</item>
    </style>
    <!--  实现全屏播放视频-->
    <style name="MyNoTitleVideo" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="HaveTitle" parent="Theme.AppCompat.Light" />

    <style name="home_tile_relative">
        <item name="android:paddingRight">24mm</item>
        <item name="android:paddingLeft">24mm</item>
        <item name="android:background">@color/colorMainLight</item>
        <item name="android:layout_width">400mm</item>
        <item name="android:layout_height">359mm</item>
        <item name="android:paddingBottom">37mm</item>
    </style>

    <style name="home_tile_relative_port">
        <item name="android:paddingBottom">37mm</item>
        <item name="android:paddingRight">24mm</item>
        <item name="android:paddingLeft">24mm</item>
        <item name="android:background">@color/colorMainLight</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">243mm</item>

    </style>

    <style name="relative_general">
        <item name="android:paddingRight">24mm</item>
        <item name="android:paddingLeft">24mm</item>
        <item name="android:layout_marginLeft">30mm</item>
        <item name="android:layout_width">870mm</item>
        <item name="android:layout_height">103mm</item>
        <item name="android:layout_marginTop">14mm</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
    </style>

    <style name="linear_aging">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">308dp</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
    </style>
    <style name="linear_aging_port">
        <item name="android:layout_marginBottom">20mm</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">308mm</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
    </style>


    <style name="device_relative">
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_width">870dp</item>
        <item name="android:layout_height">79dp</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
    </style>

    <style name="device_relative_port">
        <item name="android:layout_marginLeft">30mm</item>
        <item name="android:layout_marginRight">30mm</item>
        <item name="android:paddingRight">30mm</item>
        <item name="android:layout_marginTop">20mm</item>
        <item name="android:paddingLeft">30mm</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:background">@drawable/selector_mode_bg</item>
    </style>


    <style name="text_style">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">25dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="text_style_right">
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">25dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="text_style_right_port">
        <item name="android:layout_alignParentRight">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">25mm</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="listPopupWindow">
        <item name="android:textSize">20mm</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>